################################################################################
# Specific to work
################################################################################
if [ -z "${CODESPACE_NAME}" ]
  then
    export COMOTO_PROJECT_ROOT="$HOME"
  else
    export COMOTO_PROJECT_ROOT=/workspaces
fi

if [ -d "$COMOTO_PROJECT_ROOT/monorepo" ]
then
  source /usr/share/google-cloud-sdk/completion.bash.inc
  source ~/monorepo/zlaverse/support/bash_functions.sh

  # Worktree-scoped dev environments (w* commands). See ~/.monorepo-worktrees/README.md
  [ -f ~/.monorepo-worktrees/functions.sh ] && source ~/.monorepo-worktrees/functions.sh
  # export COMPOSE_FILE=./docker-compose.yml:./docker-compose-linux.yml
  alias ecom-log='docker logs -f --tail 1000 zla-ecom-webapp-1'
  alias ecom-logs='docker logs -f --tail 1000 zla-ecom-webapp-1'
  alias cg-log='container-log cycle-gear-redline-webapp'
  alias cg-logs='container-log cycle-gear-redline-webapp'
  alias rz-log='container-log revzilla-redline-webapp'
  alias rz-logs='container-log revzilla-redline-webapp'
  alias jp-log='container-log jp-cycles-redline-webapp'
  alias jp-logs='container-log jp-cycles-redline-webapp'
  alias p-log='container-log product-service'
  alias p-logs='container-log product-service'
  alias ps-log='container-log product-search-service'
  alias ps-logs='container-log product-search-service'
  alias elts='ecom-load-test-schema'
  alias cglts='cg-load-test-schema'
  # fixit drops the deps volumes, so it always pays a cold `mix deps.get` — which
  # dies on any group-writable file in ~/.ssh. Leading `;` not `&&`: a missing
  # helper must not abort the rebuild. See ~/.monorepo-worktrees/NOTES.md.
  alias fixit='_wt_ssh_preflight 2>/dev/null; cd ~/monorepo && docker compose down && docker volume remove zla_cg-deps zla_jp-deps zla_rz-deps zla_cg-build zla_jp-build zla_rz-build && docker compose pull && docker-compose up --scale jobs=1 --scale admin=1 --scale ecom_api=1 -d'
  alias nf='git checkout master redline/apps/redline_store_portal/package-lock.json && git checkout master redline/apps/redline_web_store/package-lock.json'
  alias dcb='docker compose down && docker compose up --scale jobs=1 --scale admin=1 --scale ecom_api=1 -d'
fi

if [ -d "$COMOTO_PROJECT_ROOT/code/comoto/scripts" ]
then
  export PATH=$PATH:~/code/comoto/scripts
fi

if [ -d "/home/brian/code/todo/integrations/bin" ]
then
  export PATH=$PATH:/home/brian/code/todo/integrations/bin
fi

if [ -d "$COMOTO_PROJECT_ROOT/ecom_api" ]
then
  source $HOME/ecom_api/scripts/bash_functions.sh
fi

export USE_GKE_GCLOUD_AUTH_PLUGIN=True

function gca () {
    gcloud auth print-access-token | clipcopy; echo "copied to clipboard"
}
