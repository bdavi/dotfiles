export EDITOR='vim'
alias cim='vim'
alias bim='vim'

# Don't rm root and prompt for multiple files
alias rm='rm -I --preserve-root'

# A few differences between bare Linux and WSL
if grep -qEi "(Microsoft|WSL)" /proc/version &> /dev/null ; then
  alias open="explorer.exe"
else
  # Under Wayland (Budgie runs labwc) keyboard settings live in labwc's config
  # files, which it reloads on --reconfigure. Under X11, set them directly.

  # Swap esc and capslock
  swapesc() {
    if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
      local env_file="${XDG_CONFIG_HOME:-$HOME/.config}/budgie-desktop/labwc/environment"
      if ! grep -qs 'caps:swapescape' "$env_file"; then
        mkdir -p "${env_file%/*}"
        if grep -qs '^XKB_DEFAULT_OPTIONS=' "$env_file"; then
          sed -i 's/^XKB_DEFAULT_OPTIONS=.*/&,caps:swapescape/' "$env_file"
        else
          echo 'XKB_DEFAULT_OPTIONS=caps:swapescape' >> "$env_file"
        fi
        labwc --reconfigure 2>/dev/null
      fi
    else
      /usr/bin/setxkbmap -option caps:swapescape
    fi
  }
  swapesc

  # Keyboard speed
  keyfast() {
    if [ "$XDG_SESSION_TYPE" = "wayland" ]; then
      local rc="${XDG_CONFIG_HOME:-$HOME/.config}/budgie-desktop/labwc/rc.xml"
      if [ -f "$rc" ] && { ! grep -qs '<repeatRate>60<' "$rc" || ! grep -qs '<repeatDelay>225<' "$rc"; }; then
        if grep -qs '<repeatRate>' "$rc"; then
          sed -i -e 's|<repeatRate>[^<]*</repeatRate>|<repeatRate>60</repeatRate>|' \
                 -e 's|<repeatDelay>[^<]*</repeatDelay>|<repeatDelay>225</repeatDelay>|' "$rc"
        else
          sed -i '0,/<keyboard>/s||<keyboard>\n\t\t<repeatRate>60</repeatRate>\n\t\t<repeatDelay>225</repeatDelay>|' "$rc"
        fi
        labwc --reconfigure 2>/dev/null
      fi
    else
      xset r rate 225 60
    fi
  }
  keyfast

  # Budgie's panel always lands on the first Wayland output (the laptop
  # eDP screen). The autostart entry installed by
  # scripts/dev_box/lib/budgie_panel.sh handles login, but the output
  # order can reshuffle mid-session too - suspend/resume, replugging a
  # monitor - and the panel jumps back. This re-runs the same
  # output-reorder trick immediately (--now skips the script's
  # login-time settle sleep).
  fix-panel() {
    bash "$HOME/.local/bin/budgie-panel-to-external.sh" --now
  }

  # Screen reslution adjustments
  alias r2k='xrandr -s 2560x1440'
  alias rhd='xrandr -s 1920x1080'

  # Reset audio so lineout is recognized by pulseaudio
  alias headphones!='sudo alsa force-reload'

  # Force IPv4 box-wide, permanently: the work VPN carries no IPv6, so
  # dual-stack destinations (e.g. the staging admin site) resolve
  # AAAA-first and route around the tunnel. A one-shot sysctl isn't
  # enough - FortiClient re-enables disable_ipv6 per interface on every
  # VPN connect (observed live 2026-08-25) and maintains v6 addresses
  # itself, so the setting has to be *enforced*, not just set. useip4
  # installs that enforcement, all root-owned system config:
  #
  #   /etc/sysctl.d/99-disable-ipv6.conf   boot + new-interface state
  #                                        (sysctl.d, not /etc/sysctl.conf
  #                                        - systemd 259 dropped the latter,
  #                                        which is why `sysctl -p` fails)
  #   /usr/local/sbin/useip4-assert        one enforcement pass, repeated
  #                                        over a ~25s settle window since
  #                                        FortiClient's flip can trail the
  #                                        tun's appearance
  #   useip4.service + useip4.timer        the assert at boot and once a
  #                                        minute as the catch-all backstop
  #   /etc/udev/rules.d/99-useip4.rules    instant re-assert the moment a
  #                                        fctvpn* tun appears or vanishes -
  #                                        the exact moment FortiClient flips
  #
  # The per-interface loop in the assert script exists because writing
  # all=1 only cascades when the value *changes*: after a FortiClient
  # flip, `all` is still 1 and a plain `sysctl --system` fixes nothing.
  # accept_ra=0 rides along so a flipped interface can't SLAAC while the
  # window is open. Idempotent - re-running rewrites the same files and
  # re-arms the timer. useip6 below disarms everything.
  useip4() {
    sudo install -d -m 0755 /usr/local/sbin /etc/sysctl.d /etc/udev/rules.d

    sudo tee /etc/sysctl.d/99-disable-ipv6.conf >/dev/null <<'EOF'
# IPv4 only: the work VPN carries no IPv6, so v6 routes around it.
# Managed by useip4 (dotfiles config_files/.commonrc-linux); enforcement
# lives in useip4.timer and /etc/udev/rules.d/99-useip4.rules.
net.ipv6.conf.all.disable_ipv6=1
net.ipv6.conf.default.disable_ipv6=1
net.ipv6.conf.all.accept_ra=0
net.ipv6.conf.default.accept_ra=0
EOF

    sudo tee /usr/local/sbin/useip4-assert >/dev/null <<'EOF'
#!/bin/sh
# (Re)disable IPv6 on every interface, repeated over a ~25s settle
# window: FortiClient flips disable_ipv6 back per interface around VPN
# connect, not always in the first second. Each interface is written
# directly because setting all=1 only cascades when the value changes.
# Installed by useip4 (dotfiles config_files/.commonrc-linux).
for delay in 0 5 5 15; do
  sleep "$delay"
  for d in /proc/sys/net/ipv6/conf/*/; do
    case "$d" in */all/|*/default/) continue ;; esac
    echo 1 > "${d}disable_ipv6" 2>/dev/null
    echo 0 > "${d}accept_ra" 2>/dev/null
  done
done
exit 0
EOF
    sudo chmod 0755 /usr/local/sbin/useip4-assert

    sudo tee /etc/systemd/system/useip4.service >/dev/null <<'EOF'
[Unit]
Description=Assert IPv4-only (re-disable IPv6 on all interfaces)

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/useip4-assert
EOF

    sudo tee /etc/systemd/system/useip4.timer >/dev/null <<'EOF'
[Unit]
Description=Re-assert IPv4-only every minute (FortiClient re-enables IPv6)

[Timer]
OnBootSec=15
OnUnitActiveSec=60
AccuracySec=5

[Install]
WantedBy=timers.target
EOF

    sudo tee /etc/udev/rules.d/99-useip4.rules >/dev/null <<'EOF'
# FortiClient re-enables IPv6 around tunnel setup/teardown - re-assert
# IPv4-only the moment a fctvpn* tun appears or vanishes. Managed by
# useip4 (dotfiles config_files/.commonrc-linux).
ACTION=="add|remove", SUBSYSTEM=="net", KERNEL=="fctvpn*", RUN+="/usr/bin/systemctl --no-block start useip4.service"
EOF

    sudo sysctl --system >/dev/null
    sudo systemctl daemon-reload
    sudo systemctl enable --now useip4.timer >/dev/null 2>&1
    sudo systemctl --no-block start useip4.service
    sudo udevadm control --reload
    echo "useip4: enforcement armed - sysctl baseline, boot + minutely timer, instant fctvpn* udev trigger"
  }

  # Disarm useip4's enforcement and re-enable IPv6. Addresses come back
  # on the next network reconnect (or reboot); NM renegotiates them.
  useip6() {
    sudo systemctl disable --now useip4.timer >/dev/null 2>&1
    sudo rm -f /etc/systemd/system/useip4.service /etc/systemd/system/useip4.timer \
      /etc/udev/rules.d/99-useip4.rules /usr/local/sbin/useip4-assert \
      /etc/sysctl.d/99-disable-ipv6.conf
    sudo systemctl daemon-reload
    sudo udevadm control --reload
    sudo sh -c 'for d in /proc/sys/net/ipv6/conf/*/; do
      echo 0 > "${d}disable_ipv6" 2>/dev/null
      echo 1 > "${d}accept_ra" 2>/dev/null
    done'
    echo "useip6: enforcement removed, IPv6 re-enabled - reconnect or reboot to get addresses back"
  }
fi
