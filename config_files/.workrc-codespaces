################################################################################
# GitHub Codespaces <-> herdr integration convenience functions
################################################################################
# All Codespaces here are assumed to be Comoto-Tech/dev-hub - see
# ~/code/dotfiles/misc/herdr_codespaces.md for the full plan and the
# verified facts these functions depend on (gh codespace ssh mechanics,
# herdr-mirror's hosts.toml schema, the preview-channel requirement).
#
# Every function logs what it's doing to stderr - this whole integration
# was designed without a live Codespace to test against, so verbose,
# obvious logging matters more here than it would in already-proven code.
################################################################################

CS_REPO="Comoto-Tech/dev-hub"
CS_HOSTS_TOML="$HOME/.config/herdr-mirror/hosts.toml"
CS_SSH_ALIASES="$HOME/.ssh/codespaces"
# herdr-add-cs won't create a codespace beyond this many existing ones
# (any state) - a cost/quota guardrail, not a herdr-mirror or gh limit.
CS_MAX_CODESPACES=3

# Files that make up "being logged into gcloud" - deliberately not the
# whole ~/.config/gcloud tree (which also holds logs/, .metrics.uuid,
# cached CLI surveys, etc.), just the credential/config material cs-sync-
# gcloud actually needs to reproduce the local login state elsewhere.
# application_default_credentials.json (a separate login,
# `gcloud auth application-default login`) is handled on its own in
# cs-sync-gcloud since it may not exist. See
# misc/codespaces_tool_auth.md for the full design rationale.
GCLOUD_CONFIG_DIR="$HOME/.config/gcloud"
GCLOUD_SYNC_FILES=(
  "credentials.db"
  "active_config"
  "configurations/config_default"
)

_cs_log() { echo "[cs] $*" >&2; }

# Regenerates ~/.ssh/codespaces and the managed [hosts.*] block in
# herdr-mirror's hosts.toml from the current Codespace list, then tells
# herdr's running server to pick up the change. Safe to call often - it's
# what makes a freshly created Codespace mirrorable and keeps the
# cs-connect picker's list current.
cs-sync() {
  _cs_log "Refreshing Codespace SSH aliases..."

  # gh codespace ssh --config can exit non-zero if it skipped an
  # unavailable/stopped codespace while still writing a usable config for
  # the rest - don't let `set -e` (if the caller has it on) treat that as
  # fatal. Capture stdout only: the "skipping unavailable codespace" notes
  # go to stderr, and merging them in corrupts the SSH config file (ssh
  # then rejects the whole file with "Bad configuration option").
  local gh_output
  if ! gh_output="$(gh codespace ssh --config)"; then
    _cs_log "gh codespace ssh --config exited non-zero (likely a stopped codespace was skipped) - continuing with what it did produce"
  fi
  printf '%s\n' "$gh_output" > "$CS_SSH_ALIASES"

  mkdir -p "$(dirname "$CS_HOSTS_TOML")"
  touch "$CS_HOSTS_TOML"

  local tmp
  tmp="$(mktemp)"
  awk '/# BEGIN codespaces \(managed\)/{skip=1} /# END codespaces/{skip=0; next} !skip' \
    "$CS_HOSTS_TOML" > "$tmp"

  {
    cat "$tmp"
    echo "# BEGIN codespaces (managed) - regenerated by cs-sync, don't hand-edit"
    # Global keys - must come before any [hosts.x] table per TOML syntax,
    # which is exactly where they're emitted. poll_seconds tuned down from
    # herdr-mirror's 60s default so a Codespace shows up locally soon after
    # `herdr` starts there - see misc/herdr_codespaces.md's poll_seconds
    # decision. autostart off so a fresh herdr session never reconnects to
    # old codespace mirrors on its own (a dead remote herdr server otherwise
    # leaves the daemon retrying forever at launch) - mirroring only starts
    # when explicitly asked for, via the start action the cs-* functions
    # already invoke.
    echo "poll_seconds = 20"
    echo "autostart = false"
    grep '^Host cs\.' "$CS_SSH_ALIASES" | while read -r _ alias; do
      # alias is cs.<name>.<escaped-ref>; codespace names don't contain
      # dots, so splitting on the first one recovers <name>.
      local name="${alias#cs.}"
      name="${name%%.*}"
      printf '[hosts.%s]\ntarget = "%s"\nremote_bin = "~/.local/bin/herdr"\n\n' \
        "$name" "$alias"
    done
    echo "# END codespaces"
  } > "$CS_HOSTS_TOML.new"

  # `command ... -f` sidesteps .commonrc's `alias mv='mv -i'`, which gets
  # baked in at function-definition time (aliases expand when a function is
  # *read*, and .commonrc defines the alias before sourcing this file) and
  # otherwise turns this into an interactive overwrite prompt on every sync.
  command mv -f "$CS_HOSTS_TOML.new" "$CS_HOSTS_TOML"
  command rm -f "$tmp"

  if herdr server reload-config 2>&1; then
    _cs_log "herdr-mirror hosts.toml updated and server reloaded"
  else
    _cs_log "hosts.toml updated, but 'herdr server reload-config' failed - is herdr running locally?"
  fi

  # reload-config alone doesn't (re)start the mirror plugin's polling
  # daemon, and the plugin's autostart only fires once at herdr launch - if
  # hosts.toml didn't exist yet at that point (exactly the first-run case,
  # confirmed live 2026-08-07), nothing ever polls and no codespace shows
  # up. The start action is documented as "Start (or resume)", so it's safe
  # to invoke unconditionally.
  if herdr plugin action invoke start --plugin mirror >/dev/null 2>&1; then
    _cs_log "mirror daemon started/resumed"
  else
    _cs_log "couldn't invoke the mirror plugin's start action - check 'herdr plugin list'"
  fi
}

# Pushes this machine's gcloud auth state - both `gcloud auth login`'s own
# credentials and (if present) Application Default Credentials - to every
# currently running Comoto-Tech/dev-hub codespace, overwriting
# ~/.config/gcloud there so each one authenticates exactly as if
# `gcloud auth login`/`gcloud auth application-default login` had been run
# on it directly. Manual, by design - run it yourself any time after
# re-authenticating locally. See misc/codespaces_tool_auth.md for the full
# design rationale (why a file push over the existing SSH transport rather
# than a Codespaces secret or a short-lived-token relay, why this is a
# manual trigger rather than a background watcher, and the security
# tradeoffs of copying credential material to several remote machines).
cs-sync-gcloud() {
  if [[ ! -d "$GCLOUD_CONFIG_DIR" ]]; then
    _cs_log "No local gcloud config at $GCLOUD_CONFIG_DIR - run 'gcloud auth login' first"
    return 1
  fi

  cs-sync

  local -a targets
  mapfile -t targets < <(grep '^Host cs\.' "$CS_SSH_ALIASES" 2>/dev/null | awk '{print $2}')

  if [[ ${#targets[@]} -eq 0 ]]; then
    _cs_log "No codespace SSH aliases found"
    return 1
  fi

  local adc_file="$GCLOUD_CONFIG_DIR/application_default_credentials.json"
  local target f ok
  for target in "${targets[@]}"; do
    _cs_log "Pushing gcloud auth to $target..."
    ok=1

    ssh -o BatchMode=yes "$target" "mkdir -p ~/.config/gcloud/configurations" 2>/dev/null || {
      _cs_log "  couldn't reach $target - skipping"
      continue
    }

    for f in "${GCLOUD_SYNC_FILES[@]}"; do
      [[ -f "$GCLOUD_CONFIG_DIR/$f" ]] || continue
      scp -o BatchMode=yes -q "$GCLOUD_CONFIG_DIR/$f" "$target:.config/gcloud/$f" || ok=0
    done
    if [[ -f "$adc_file" ]]; then
      scp -o BatchMode=yes -q "$adc_file" "$target:.config/gcloud/application_default_credentials.json" || ok=0
    fi

    # Match gcloud's own restrictive file permissions - these are
    # credential material, and anything else running under the codespace's
    # user account (an installed dependency, a devcontainer feature, ...)
    # can otherwise read them same as you can. Errors suppressed: a file
    # that didn't get copied above (missing locally) has nothing to chmod.
    ssh -o BatchMode=yes "$target" \
      'chmod 600 ~/.config/gcloud/credentials.db ~/.config/gcloud/application_default_credentials.json 2>/dev/null' \
      || true

    if [[ "$ok" == 1 ]]; then
      _cs_log "  done"
    else
      _cs_log "  one or more files failed to copy to $target"
    fi
  done
}

# Lists open Comoto-Tech/dev-hub codespaces as tab-separated
# name/state/branch rows, for cs-connect/cs-remote's picker.
_cs_list_raw() {
  gh codespace list --repo "$CS_REPO" \
    --json name,state,gitStatus \
    --jq '.[] | "\(.name)\t\(.state)\t\(.gitStatus.ref // "?")"'
}

# Interactive picker: existing codespaces + "Create new". Uses fzf if
# present (it already is, on this machine, via the neovim install), falls
# back to a plain `select` menu otherwise. Echoes the chosen codespace name
# (or the literal string "NEW") on stdout - callers should capture it, not
# read other output, since everything else here logs to stderr.
_cs_pick() {
  local -a names=()
  local line name state ref
  while IFS=$'\t' read -r name state ref; do
    [[ -z "$name" ]] && continue
    names+=("$name ($state, $ref)")
  done < <(_cs_list_raw)

  names+=("Create new codespace")

  if command -v fzf >/dev/null; then
    line="$(printf '%s\n' "${names[@]}" | fzf --prompt="Codespace> " --height=~40%)"
  else
    PS3="Codespace> "
    select line in "${names[@]}"; do
      break
    done
  fi

  if [[ -z "$line" ]]; then
    _cs_log "No selection made"
    return 1
  elif [[ "$line" == "Create new codespace" ]]; then
    echo "NEW"
  else
    echo "${line%% (*}"
  fi
}

# Creates a new dev-hub codespace and waits for it to be connectable.
# Logs progress since `gh codespace create` can take a couple of minutes
# and gives little feedback of its own.
_cs_create() {
  _cs_log "Creating new codespace in $CS_REPO (this can take a few minutes)..."
  local name
  name="$(gh codespace create --repo "$CS_REPO" --json name --jq .name)" || {
    _cs_log "gh codespace create failed"
    return 1
  }
  _cs_log "Created $name, waiting for it to become Available..."

  local state
  for _ in $(seq 1 60); do
    state="$(gh codespace list --json name,state --jq ".[] | select(.name==\"$name\") | .state")"
    _cs_log "  state: $state"
    [[ "$state" == "Available" ]] && break
    sleep 5
  done

  if [[ "$state" != "Available" ]]; then
    _cs_log "Codespace $name did not reach Available after 5 minutes - check 'gh codespace list' manually"
    return 1
  fi

  echo "$name"
}

# The main entry point for step 3 of the workflow: run inside a fresh
# herdr workspace, lists/creates a codespace, and drops you into an
# interactive SSH session on it. Once inside, per step 4, just run
# `herdr` - see misc/herdr_codespaces.md's "Mechanism check on step 4" for
# what that actually does mechanically (local herdr-mirror is already
# polling in the background; this just gives it a registered host and a
# running server to find).
cs-connect() {
  cs-sync

  local choice
  choice="$(_cs_pick)" || return 1

  local target_name
  if [[ "$choice" == "NEW" ]]; then
    target_name="$(_cs_create)" || return 1
    cs-sync   # register the new codespace's alias before connecting
  else
    target_name="$choice"
  fi

  _cs_log "Connecting to $target_name..."
  # exec, not a subshell call - the herdr workspace's pane should just
  # become "you, inside the codespace shell", matching how csclaude
  # already behaves for the plain-ssh case in .commonrc.
  exec env HERDR_AGENT=claude gh codespace ssh -c "$target_name"
}

# Copies the most recent URL printed in the codespace's panes into the
# local clipboard, reading the *remote* herdr's pane buffers over SSH.
# The mirror rendering bug that originally motivated this (each wrapped
# row losing its last character) is fixed by the patched plugin build
# (install_herdr_mirror_plugin, lib/herdr.sh), but this stays useful:
# mirror panes still drop OSC 52 (upstream issue #25), so remote-side
# "copy to clipboard" offers like Claude Code's never reach the local
# clipboard, and a wrapped URL selected by hand still needs its line
# breaks removed - this does both in one shot. Assumes the
# single-codespace workflow: uses the first SSH alias in
# ~/.ssh/codespaces.
cs-copy-url() {
  local ssh_alias
  ssh_alias="$(grep '^Host cs\.' "$CS_SSH_ALIASES" 2>/dev/null | awk '{print $2; exit}')"
  if [[ -z "$ssh_alias" ]]; then
    _cs_log "No codespace SSH alias found - run cs-sync first"
    return 1
  fi

  # Last URL block in the remote panes' buffers (focused pane first, then
  # the rest): from a line containing https:// through the next blank
  # line, rows joined (the remote wraps mid-token with no spaces, so
  # plain concatenation is safe). pane read returns only the current
  # screen on this build (its --lines/--source flags are advertised but
  # rejected), so this finds the URL only while it's still displayed.
  local url
  url="$(ssh -o BatchMode=yes "$ssh_alias" '
    bin=~/.local/bin/herdr
    cur=$($bin pane current 2>/dev/null | grep -o "\"pane_id\":\"[^\"]*\"" | head -1 | cut -d"\"" -f4)
    for p in $cur $($bin pane list 2>/dev/null | grep -o "\"pane_id\":\"[^\"]*\"" | cut -d"\"" -f4 | grep -v "^$cur\$"); do
      out=$($bin pane read "$p" 2>/dev/null | awk "/https?:\\/\\//{rec=\"\"; on=1} on{if (\$0 ~ /^[[:space:]]*\$/) on=0; else rec=rec \$0} END{print rec}")
      if [ -n "$out" ]; then printf "%s" "$out"; exit 0; fi
    done
  ' 2>/dev/null | tr -d ' ')"

  if [[ -z "$url" ]]; then
    _cs_log "No URL on any codespace pane's screen right now - it only sees what's currently displayed, so run this while the URL is visible"
    return 1
  fi

  printf '%s' "$url" | clipcopy
  _cs_log "Copied ${#url} chars to clipboard: ${url:0:60}..."
}

# Fallback path for when the mirror isn't cooperating (or you just want
# it): attaches herdr's own built-in --remote directly, replacing the
# local view with that one codespace's, no plugin/preview channel
# required beyond herdr already being installed there. Run from the
# local workspace, not from inside an SSH session - see Option B in
# misc/herdr_codespaces.md. Deliberately not auto-invoked by cs-connect -
# they're kept as two separate, manually-chosen functions.
cs-remote() {
  cs-sync

  local choice
  choice="$(_cs_pick)" || return 1

  local target_name
  if [[ "$choice" == "NEW" ]]; then
    target_name="$(_cs_create)" || return 1
    cs-sync
  else
    target_name="$choice"
  fi

  local ssh_alias
  ssh_alias="$(grep '^Host cs\.' "$CS_SSH_ALIASES" | awk -v n="$target_name" '$2 ~ "^cs\\."n"\\." {print $2; exit}')"
  if [[ -z "$ssh_alias" ]]; then
    _cs_log "Couldn't find an SSH alias for $target_name in $CS_SSH_ALIASES - try cs-sync"
    return 1
  fi

  _cs_log "Attaching herdr --remote to $ssh_alias..."
  herdr --remote "$ssh_alias"
}

# One-shot "grow the mirror by one": finds a Comoto-Tech/dev-hub codespace
# not already mirrored into this herdr session and gets herdr running there
# (creating a new codespace if every existing one is already mirrored), so
# it shows up in the local sidebar within herdr-mirror's poll_seconds - no
# manual gh codespace ssh/typing herdr required. Unlike cs-connect, this
# never drops you into an interactive session - it's meant to be run
# unattended, e.g. bound to a herdr keybinding later if that's useful.
#
# No-op outside a local herdr pane, by design: a no-op if $HERDR_ENV isn't
# set (not inside herdr at all), and also a no-op if $CODESPACE_NAME is set
# - that means this shell is actually running on a Codespace, whether
# reached by a direct `gh codespace ssh`/cs-connect session or by typing
# into a *mirrored* pane (mirror only renders the remote pane locally;
# anything typed into one executes on the remote shell, same as SSHing in
# directly - there's no separate "local" shell context to distinguish
# there). Either way `herdr workspace list` there would show that
# Codespace's own workspaces, not this machine's mirror state, so the
# "which codespaces are already connected" check below would be
# meaningless if allowed to run there.
herdr-add-cs() {
  if [[ -z "${HERDR_ENV:-}" ]]; then
    return 0
  fi
  if [[ -n "${CODESPACE_NAME:-}" ]]; then
    _cs_log "herdr-add-cs: running inside a Codespace shell (direct SSH or a mirrored pane), not the local machine's own herdr - doing nothing"
    return 0
  fi

  cs-sync

  # Labels of every workspace this herdr session currently knows about,
  # mirrored ones included - herdr-mirror prefixes each with
  # "<codespace-name>: <workspace-name>" (confirmed live, see
  # misc/herdr_codespaces.md's live test results). grep, not jq - matches
  # this file's existing lightweight-JSON-field-extraction style (see
  # cs-copy-url) rather than adding a new dependency.
  local -a labels
  mapfile -t labels < <(herdr workspace list 2>/dev/null | grep -o '"label":"[^"]*"' | cut -d'"' -f4)

  local -a names states
  local name state ref
  while IFS=$'\t' read -r name state ref; do
    [[ -z "$name" ]] && continue
    names+=("$name")
    states+=("$state")
  done < <(_cs_list_raw)

  # First codespace not already mirrored, preferring one already running
  # (Available) over a stopped one - avoids extra resume latency when
  # there's a choice. Doesn't break out of the loop on a non-Available
  # match, so a later Available-and-unmirrored codespace still wins.
  local target_name="" i label already
  for i in "${!names[@]}"; do
    already=0
    for label in "${labels[@]}"; do
      [[ "$label" == "${names[$i]}: "* ]] && { already=1; break; }
    done
    [[ "$already" == 1 ]] && continue

    if [[ "${states[$i]}" == "Available" ]]; then
      target_name="${names[$i]}"
      break
    elif [[ -z "$target_name" ]]; then
      target_name="${names[$i]}"
    fi
  done

  if [[ -z "$target_name" ]]; then
    if [[ ${#names[@]} -ge $CS_MAX_CODESPACES ]]; then
      _cs_log "herdr-add-cs: ERROR: every existing codespace is already mirrored, and there are already ${#names[@]}/$CS_MAX_CODESPACES - not creating another"
      return 1
    fi
    _cs_log "herdr-add-cs: every existing codespace is already mirrored - creating a new one"
    target_name="$(_cs_create)" || return 1
    cs-sync
  else
    _cs_log "herdr-add-cs: found an unmirrored codespace, $target_name"
  fi

  local ssh_alias
  ssh_alias="$(grep '^Host cs\.' "$CS_SSH_ALIASES" | awk -v n="$target_name" '$2 ~ "^cs\\."n"\\." {print $2; exit}')"
  if [[ -z "$ssh_alias" ]]; then
    _cs_log "herdr-add-cs: couldn't find an SSH alias for $target_name - try cs-sync"
    return 1
  fi

  # Non-interactive: start herdr's headless server on the codespace and
  # detach, rather than an interactive `gh codespace ssh` session (that's
  # cs-connect's job - this function is meant to be run unattended).
  # NEEDS LIVE VERIFICATION: `herdr server`'s exact flags and whether it
  # self-daemonizes were never confirmed against a real Codespace (see
  # misc/herdr_codespaces.md's live test results, which only exercised
  # plain interactive `herdr`) - nohup+disown handles "survive the SSH
  # session closing" at the shell level regardless of that, but if `herdr
  # server` turns out to need different flags this is the line to fix.
  if ssh -o BatchMode=yes "$ssh_alias" \
    'nohup ~/.local/bin/herdr server </dev/null >/tmp/herdr-add-cs.log 2>&1 & disown'; then
    _cs_log "herdr-add-cs: started herdr on $target_name - should appear in the mirror within ~20s"
  else
    _cs_log "herdr-add-cs: couldn't reach $target_name over SSH"
    return 1
  fi
}
